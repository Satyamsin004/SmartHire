# ==============================================================================
# SmartHire AI — Real Production Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate the required environment variables with your production credentials.
# 3. NEVER commit .env, private keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=production                    # "production" or "development"
PROJECT_NAME="SmartHire AI Engine"
VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. Application Security & JWT Cryptography
# ------------------------------------------------------------------------------
# Generate a strong 64-character secret using: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 3. Production PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# In production, USE_SQLITE must always be set to false.
USE_SQLITE=false

POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-development-or-production-password>
POSTGRES_DB=smarthire_db

# Optional direct connection string override (e.g. for AWS RDS, Supabase, Neon):
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# SYNC_DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<dbname>

# ------------------------------------------------------------------------------
# 4. Redis Cache & Session Token Blacklist
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. Production Domains & CORS Security
# ------------------------------------------------------------------------------
# The fully qualified HTTPS URL of your frontend application
FRONTEND_URL=https://smarthireai.up.railway.app

# Additional trusted production origins (comma-separated, without wildcards)
# Example: https://app.your-production-domain.com,https://admin.your-production-domain.com
CORS_ORIGINS=https://smarthireai.up.railway.app

# ------------------------------------------------------------------------------
# 6. Multi-LLM Provider API Keys & Load-Balancing Pool
# ------------------------------------------------------------------------------
# Google Gemini API Keys (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.6-flash

# OpenRouter API Keys (Meta LLaMA, Claude, DeepSeek, etc.)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Groq High-Speed Inference API Keys (Whisper & LLaMA fallback)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# 7. OAuth 2.0 Authentication (Google Sign-In)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://smarthire-production-675e.up.railway.app/api/v1/auth/google/callback

# ------------------------------------------------------------------------------
# 8. Production SMTP Email Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@your-production-domain.com

# ------------------------------------------------------------------------------
# 9. Persistent File Storage Paths
# ------------------------------------------------------------------------------
# Mounted host/volume directories for persistent media (not ephemeral container layers)
RECORDINGS_DIR=/app/static/uploads/recordings
UPLOADS_DIR=/app/static/uploads

# ------------------------------------------------------------------------------
# 10. Frontend Build Variables (Client-Side .env)
# ------------------------------------------------------------------------------
# Note: Keep relative "/api/v1" when served behind Nginx reverse proxy on same domain.
VITE_API_URL=/api/v1
# VITE_WS_URL=wss://your-production-domain.com
