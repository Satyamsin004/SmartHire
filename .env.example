# ==============================================================================
# SmartHire AI - Environment Configuration Template
# Copy this file to .env and configure your credentials
# ==============================================================================

# Application Security
SECRET_KEY=smarthire-ai-super-secret-production-key-2026-key

# Database Selection
# Set USE_SQLITE=true for instant local development without PostgreSQL
USE_SQLITE=true

# PostgreSQL Configuration (used when USE_SQLITE=false or via Docker Compose)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword2026
POSTGRES_DB=smarthire_db

# Redis Configuration (Optional, for caching / task queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# Multi-LLM Provider API Keys & Load Balancing Pool
# Provide one or more keys; SmartHire automatically load-balances and fails over
# ==============================================================================

# Google Gemini API Keys (Gemini 2.0 Flash / Pro)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter API Keys (Meta LLaMA, Claude, DeepSeek, etc.)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Groq High-Speed Inference API Keys
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# OAuth 2.0 Authentication (Google Sign-In)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Frontend Client URL
FRONTEND_URL=http://localhost:3001
